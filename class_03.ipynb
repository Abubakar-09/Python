data = list()
go_on = "y"
i = 0
while go_on == "y" or go_on == "Y":
    student = dict(name="none", roll_num=0, subject=dict(Math=0, Phy=0, Com=0, Eng=0, Urdu=0))
    student["name"] = input(f"Enter the {i+1} student name: ")
    student["roll_num"] = input(f"Enter the {i+1} student Roll Number: ")
    student["subject"]["Math"] = int(input(f"Enter the {i+1} student Math Marks: "))
    student["subject"]["Phy"] = int(input(f"Enter the {i+1} student Phy Marks: "))
    student["subject"]["Com"] = int(input(f"Enter the {i+1} student Com Marks: "))
    student["subject"]["Eng"] = int(input(f"Enter the {i+1} student Eng Marks: "))
    student["subject"]["Urdu"] = int(input(f"Enter the {i+1} student Urdu Marks: "))

    while any(mark < 0 or mark > 100 for mark in student["subject"].values()):
        print("Invalid Marks! Marks should be between 0 and 100.")
        student["name"] = input(f"Enter the {i+1} student name: ")
        student["roll_num"] = input(f"Enter the {i+1} student Roll Number: ")
        student["subject"]["Math"] = int(input(f"Enter the {i+1} student Math Marks: "))
        student["subject"]["Phy"] = int(input(f"Enter the {i+1} student Phy Marks: "))
        student["subject"]["Com"] = int(input(f"Enter the {i+1} student Com Marks: "))
        student["subject"]["Eng"] = int(input(f"Enter the {i+1} student Eng Marks: "))
        student["subject"]["Urdu"] = int(input(f"Enter the {i+1} student Urdu Marks: "))

    i += 1
    data.append(student)
    go_on = input("Want to continue? (y/n): ")

for i in data:
    total_marks = sum(i['subject'].values())
    percentage = (total_marks / 500) * 100

    print("\n" + "-"*4 + " Student Data " + "-"*4)
    print(f"Name: {i['name']}")
    print(f"Roll Number: {i['roll_num']}")
    for subject, marks in i['subject'].items():
        print(f"{subject}: {marks} out of 100")
    print(f"Total Marks: {total_marks} out of 500")
    print(f"Percentage: {percentage:.2f}%")

    if percentage >= 80:
        print("Grade: A+")
    elif percentage >= 70:
        print("Grade: A")
    elif percentage >= 60:
        print("Grade: B")
    elif percentage >= 50:
        print("Grade: C")
    else:
        print("Grade: F")

    print("-"*4 + " Student Data " + "-"*4 + "\n")
